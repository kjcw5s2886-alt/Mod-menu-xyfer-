local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local configStore = DataStoreService:GetDataStore("PlayerGUIConfig_v2")

------------------------------------------------
-- REMOTES
------------------------------------------------

local loadConfig = ReplicatedStorage:FindFirstChild("LoadGUIConfig")

if not loadConfig then
	loadConfig = Instance.new("RemoteFunction")
	loadConfig.Name = "LoadGUIConfig"
	loadConfig.Parent = ReplicatedStorage
end

local saveConfig = ReplicatedStorage:FindFirstChild("SaveGUIConfig")

if not saveConfig then
	saveConfig = Instance.new("RemoteEvent")
	saveConfig.Name = "SaveGUIConfig"
	saveConfig.Parent = ReplicatedStorage
end

------------------------------------------------
-- DEFAULT CONFIG
------------------------------------------------

local DEFAULT_CONFIG = {
	Draggable = true,

	VisualEnabled = false,

	WalkSpeed = 16,
	JumpPower = 50,

	OPEnabled = false,
}

------------------------------------------------
-- SESSION FALLBACK
------------------------------------------------

local sessionData = {}

------------------------------------------------
-- COPY TABLE
------------------------------------------------

local function copyTable(tbl)
	local newTable = {}

	for key, value in pairs(tbl) do
		newTable[key] = value
	end

	return newTable
end

------------------------------------------------
-- VALIDATE
------------------------------------------------

local function validateConfig(config)
	local validated = copyTable(DEFAULT_CONFIG)

	if typeof(config) ~= "table" then
		return validated
	end

	if typeof(config.Draggable) == "boolean" then
		validated.Draggable = config.Draggable
	end

	if typeof(config.VisualEnabled) == "boolean" then
		validated.VisualEnabled = config.VisualEnabled
	end

	if typeof(config.WalkSpeed) == "number" then
		validated.WalkSpeed = math.clamp(config.WalkSpeed, 8, 50)
	end

	if typeof(config.JumpPower) == "number" then
		validated.JumpPower = math.clamp(config.JumpPower, 25, 100)
	end

	if typeof(config.OPEnabled) == "boolean" then
		validated.OPEnabled = config.OPEnabled
	end

	return validated
end

------------------------------------------------
-- LOAD
------------------------------------------------

loadConfig.OnServerInvoke = function(player)

	local key = "Player_" .. player.UserId

	local success, data = pcall(function()
		return configStore:GetAsync(key)
	end)

	if success then

		if data then
			local validated = validateConfig(data)
			sessionData[player.UserId] = validated

			print("Loaded saved config for", player.Name)

			return validated
		else
			local defaults = copyTable(DEFAULT_CONFIG)
			sessionData[player.UserId] = defaults

			print("No previous save found for", player.Name)

			return defaults
		end

	else

		warn("DataStore unavailable.")
		warn("Using temporary session config instead.")
		warn(data)

		if sessionData[player.UserId] then
			return sessionData[player.UserId]
		end

		local defaults = copyTable(DEFAULT_CONFIG)
		sessionData[player.UserId] = defaults

		return defaults
	end
end

------------------------------------------------
-- SAVE
------------------------------------------------

saveConfig.OnServerEvent:Connect(function(player, config)

	local validated = validateConfig(config)

	sessionData[player.UserId] = validated

	local key = "Player_" .. player.UserId

	local success, errorMessage = pcall(function()

		configStore:UpdateAsync(key, function(oldData)

			return validated

		end)

	end)

	if success then

		print("Config saved for", player.Name)

	else

		warn("Could not save DataStore config for", player.Name)
		warn(errorMessage)
		warn("Config is saved temporarily for this server session.")

	end
end)
